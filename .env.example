# Database (Neon / Supabase / any Postgres)
DATABASE_URL=postgres://eastwest:eastwest@127.0.0.1:5432/eastwest
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# M-Pesa (Safaricom Daraja). MPESA_ENV=sandbox until the Paybill is live.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For a Till: the till number (PartyB). Leave empty for a Paybill.
MPESA_TILL_NUMBER=
MPESA_CALLBACK_SECRET=change-me

# Cards (Paystack)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# SMS (Africa's Talking)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Email (any SMTP, e.g. Google Workspace, Zoho, Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@eastwest.ke

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test mode: shows a "simulate payment" button and prints SMS codes to the server log.
# Never enable in production.
DEMO_MODE=true

# Vercel Blob (image and video uploads in production; leave empty locally)
BLOB_READ_WRITE_TOKEN=
